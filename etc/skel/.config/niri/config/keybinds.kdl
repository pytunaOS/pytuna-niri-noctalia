binds {

    // ────────────── Keybindings ──────────────
    // https://github.com/YaLTeR/niri/wiki/Configuration:-Key-Bindings

    // ─── noctalia-shell keybinds ───
    // https://docs.noctalia.dev/getting-started/keybinds/

    Mod+Shift+ESCAPE                    hotkey-overlay-title="Mostrar Atalhos" { show-hotkey-overlay; }

    // ─── Applications ───
    Mod+Return                          hotkey-overlay-title="Abrir Terminal" { spawn "alacritty"; }
    Mod+CTRL+Return                     hotkey-overlay-title="Abrir Lançador de Aplicativos" { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+B                               hotkey-overlay-title="Abrir Brave" { spawn "brave"; }
    Mod+ALT+L                           hotkey-overlay-title="Bloquear Tela" { spawn-sh "noctalia msg session lock"; }
    Mod+Shift+Q                         hotkey-overlay-title="Abrir Menu da Sessão" { spawn-sh "noctalia msg panel-toggle session"; }

    // Please choose your own file manager.
    Mod+E                               hotkey-overlay-title="Abrir Gerenciador de Arquivos" { spawn "nautilus"; }

    // ─── Media Controls ───
    XF86AudioRaiseVolume                allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume                allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute                       allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioMicMute                    allow-when-locked=true { spawn-sh "noctalia msg mic-mute"; }
    XF86AudioNext                       allow-when-locked=true { spawn-sh "noctalia msg media next"; }
    XF86AudioPrev                       allow-when-locked=true { spawn-sh "noctalia msg media previous"; }
    XF86AudioPlay                       allow-when-locked=true { spawn-sh "noctalia msg media play"; }
    XF86AudioPause                      allow-when-locked=true { spawn-sh "noctalia msg media pause"; }

    // ─── Brightness Controls ───
    XF86MonBrightnessUp                 allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown               allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }

    // ─── Window Movement and Focus ───
    Mod+Q                               hotkey-overlay-title="Fechar Janela" { close-window; }

    Mod+Left                            hotkey-overlay-title="Mover Janela para a Esquerda" { focus-column-left; }
    Mod+H                               { focus-column-left; }
    Mod+Right                           hotkey-overlay-title="Mover Janela para a Direita" { focus-column-right; }
    Mod+L                               { focus-column-right; }
    Mod+Up                              hotkey-overlay-title="Mover Janela para Cima" { focus-window-up; }
    Mod+K                               { focus-window-up; }
    Mod+Down                            hotkey-overlay-title="Mover Janela para Baixo" { focus-window-down; }
    Mod+J                               { focus-window-down; }

    Mod+CTRL+Left                       hotkey-overlay-title="Mover Coluna para a Esquerda" { move-column-left; }
    Mod+CTRL+H                          { move-column-left; }
    Mod+CTRL+Right                      hotkey-overlay-title="Mover Coluna para a Direita" { move-column-right; }
    Mod+CTRL+L                          { move-column-right; }
    Mod+CTRL+UP                         hotkey-overlay-title="Mover Coluna para Cima" { move-window-up; }
    Mod+CTRL+K                          { move-window-up; }
    Mod+CTRL+Down                       hotkey-overlay-title="Mover Coluna para Baixo" { move-window-down; }
    Mod+CTRL+J                          { move-window-down; }

    Mod+Home                            { focus-column-first; }
    Mod+End                             { focus-column-last; }
    Mod+CTRL+Home                       { move-column-to-first; }
    Mod+CTRL+End                        { move-column-to-last; }

    Mod+Shift+Left                      { focus-monitor-left; }
    Mod+Shift+Right                     { focus-monitor-right; }
    Mod+Shift+UP                        { focus-monitor-up; }
    Mod+Shift+Down                      { focus-monitor-down; }

    Mod+Shift+CTRL+Left                 { move-column-to-monitor-left; }
    Mod+Shift+CTRL+Right                { move-column-to-monitor-right; }
    Mod+Shift+CTRL+UP                   { move-column-to-monitor-up; }
    Mod+Shift+CTRL+Down                 { move-column-to-monitor-down; }

    // ─── Workspace Switching ───
    Mod+WheelScrollDown                 cooldown-ms=150 hotkey-overlay-title="Ir para a Área de Trabalho Abaixo" { focus-workspace-down; }
    Mod+WheelScrollUp                   cooldown-ms=150 hotkey-overlay-title="Ir para a Área de Trabalho Acima" { focus-workspace-up; }
    Mod+CTRL+WheelScrollDown            cooldown-ms=150 hotkey-overlay-title="Mover Coluna para a Área de Trabalho Abaixo" { move-column-to-workspace-down; }
    Mod+CTRL+WheelScrollUp              cooldown-ms=150 hotkey-overlay-title="Mover Coluna para a Área de Trabalho Acima" { move-column-to-workspace-up; }

    Mod+WheelScrollRight                { focus-column-right; }
    Mod+WheelScrollLeft                 { focus-column-left; }
    Mod+CTRL+WheelScrollRight           { move-column-right; }
    Mod+CTRL+WheelScrollLeft            { move-column-left; }

    Mod+Shift+WheelScrollDown           { focus-column-right; }
    Mod+Shift+WheelScrollUp             { focus-column-left; }
    Mod+CTRL+Shift+WheelScrollDown      { move-column-right; }
    Mod+CTRL+Shift+WheelScrollUp        { move-column-left; }

    Mod+1                               { focus-workspace 1; }
    Mod+2                               { focus-workspace 2; }
    Mod+3                               { focus-workspace 3; }
    Mod+4                               { focus-workspace 4; }
    Mod+5                               { focus-workspace 5; }
    Mod+6                               { focus-workspace 6; }
    Mod+7                               { focus-workspace 7; }
    Mod+8                               { focus-workspace 8; }
    Mod+9                               { focus-workspace 9; }

    Mod+CTRL+1                          { move-column-to-workspace 1; }
    Mod+CTRL+2                          { move-column-to-workspace 2; }
    Mod+CTRL+3                          { move-column-to-workspace 3; }
    Mod+CTRL+4                          { move-column-to-workspace 4; }
    Mod+CTRL+5                          { move-column-to-workspace 5; }
    Mod+CTRL+6                          { move-column-to-workspace 6; }
    Mod+CTRL+7                          { move-column-to-workspace 7; }
    Mod+CTRL+8                          { move-column-to-workspace 8; }
    Mod+CTRL+9                          { move-column-to-workspace 9; }

    Mod+TAB                             { focus-workspace-previous; }

    // ─── Layout Controls ───
    Mod+CTRL+F                          { expand-column-to-available-width; }
    Mod+C                               { center-column; }
    Mod+CTRL+C                          { center-visible-columns; }
    Mod+Minus                           { set-column-width "-10%"; }
    Mod+Equal                           { set-column-width "+10%"; }
    Mod+Shift+Minus                     { set-window-height "-10%"; }
    Mod+Shift+Equal                     { set-window-height "+10%"; }

    // ─── Previously Unbound Layout Controls ───
    Mod+R                               hotkey-overlay-title="Alternar Largura da Coluna" { switch-preset-column-width; }
    Mod+Shift+F                         hotkey-overlay-title="Maximizar Coluna" { maximize-column; }
    Mod+BracketLeft                     hotkey-overlay-title="Incorporar ou Expulsar Janela à Esquerda" { consume-or-expel-window-left; }
    Mod+BracketRight                    hotkey-overlay-title="Incorporar ou Expulsar Janela à Direita" { consume-or-expel-window-right; }

    // ─── Modes ───
    Mod+T                               hotkey-overlay-title="Alternar Janela entre Flutuante e Lado a Lado" { toggle-window-floating; }
    Mod+Shift+T                         hotkey-overlay-title="Alternar Foco entre Flutuante e Lado a Lado" { switch-focus-between-floating-and-tiling; }
    Mod+F                               { fullscreen-window; }
    Mod+W                               { toggle-column-tabbed-display; }

    // ─── Screenshots ───
    CTRL+Shift+1                        hotkey-overlay-title="Capturar Tela" { screenshot; }
    CTRL+Shift+2                        { screenshot-screen; }
    CTRL+Shift+3                        { screenshot-window; }

    // ─── Emergency Escape Key ───
    // Use this when a fullscreen app blocks your keybinds.
    // It disables any active keyboard shortcut inhibitor, restoring control.
    Mod+ESCAPE                          allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // ─── Exit / Power ───
    CTRL+ALT+Delete                     hotkey-overlay-title="Sair" { quit; } // Also quits Niri
    Mod+Shift+P                         { power-off-monitors; } // Turn off screens (useful for OLED or privacy)
    Mod+O                               repeat=false hotkey-overlay-title="Abrir Visão Geral" { toggle-overview; }
}
