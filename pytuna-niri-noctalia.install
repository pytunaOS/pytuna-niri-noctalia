post_install() {
  echo "pytuna-niri-noctalia installed."
  echo "New users created after this point will get Niri + Noctalia settings via /etc/skel."
  echo "Existing users: copy files from /etc/skel manually or re-create your user."
}

post_upgrade() {
  echo "pytuna-niri-noctalia updated."
  echo "/etc/skel was refreshed; existing home directories are NOT modified automatically."
}
